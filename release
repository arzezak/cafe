#!/bin/sh

set -eu

cd "$(dirname "$0")"

repo=arzezak/cafe
tap=arzezak/homebrew-tap
notary_profile=cafe-notary

app=build/Build/Products/Release/Cafe.app
zip=build/Build/Products/Release/Cafe.zip
cask_file="repos/$tap/contents/Casks/cafe.rb"

version=$(sed -n 's/^ *MARKETING_VERSION: *"\(.*\)"/\1/p' project.yml)
tag="v$version"

check_ready() {
  if [ "$(git branch --show-current)" != main ]; then
    echo "error: releases are cut from main" >&2
    exit 1
  fi

  case "$version" in
    "" | *[!0-9.]*)
      echo "error: MARKETING_VERSION in project.yml must be digits and dots" >&2
      exit 1
      ;;
  esac

  if [ -n "$(git status --porcelain)" ]; then
    echo "error: the working tree has uncommitted changes" >&2
    exit 1
  fi

  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    echo "error: $tag already exists; bump MARKETING_VERSION in project.yml" >&2
    exit 1
  fi

  cask_sha=$(gh api "$cask_file" --jq .sha)
}

build() {
  xcodegen generate

  xcodebuild -project Cafe.xcodeproj -scheme Cafe -configuration Release \
    -derivedDataPath build \
    CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY="Developer ID Application" \
    OTHER_CODE_SIGN_FLAGS=--timestamp CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO \
    ARCHS="arm64 x86_64" ONLY_ACTIVE_ARCH=NO clean build
}

zip_app() {
  rm -f "$zip"
  ditto -c -k --keepParent "$app" "$zip"
}

notarize() {
  zip_app
  xcrun notarytool submit "$zip" --keychain-profile "$notary_profile" --wait
  xcrun stapler staple "$app"
  zip_app

  checksum=$(shasum -a 256 "$zip")
  checksum=${checksum%% *}
}

publish_release() {
  git tag "$tag"
  git push origin HEAD "$tag"
  gh release create "$tag" "$zip" --repo "$repo" --title "$version" --generate-notes
}

cask() {
  cat <<EOF
cask "cafe" do
  version "$version"
  sha256 "$checksum"

  url "https://github.com/$repo/releases/download/v#{version}/Cafe.zip"
  name "Cafe"
  desc "Menu bar toggle that keeps a Mac awake"
  homepage "https://github.com/$repo"

  depends_on macos: :ventura

  app "Cafe.app"
end
EOF
}

publish_cask() {
  gh api -X PUT "$cask_file" \
    -f message="cafe $version" \
    -f content="$(cask | base64)" \
    -f sha="$cask_sha" >/dev/null
}

check_ready
build
notarize
publish_release
publish_cask

echo "Released $tag: brew install --cask arzezak/tap/cafe"
